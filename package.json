{
  "name": "slur-monorepo",
  "private": true,
  "version": "0.0.0",
  "description": "Slur — collaboration for music makers. Plugin / web / mobile / marketing.",
  "scripts": {
    "dev": "pnpm --filter plugin dev",
    "dev:plugin": "pnpm --filter plugin dev",
    "build:plugin": "pnpm --filter plugin build",
    "typecheck:plugin": "pnpm --filter plugin exec tsc -b",
    "test:security": "node --experimental-strip-types --test tests/security/*.test.mjs",
    "dev:games:qa": "pnpm --filter plugin exec vite --config ../../tests/games/vite.config.mjs",
    "test:games:layout": "node tests/games/audit.browser.mjs",
    "test:games:regression": "node tests/games/regression.browser.mjs",
    "test:games:lifecycle": "node tests/games/lifecycle.browser.mjs",
    "test:games:chess3d": "node tests/games/chess3d.browser.mjs",
    "test:games:chess3d:rules": "node --experimental-strip-types --test tests/games/chess3d.test.mjs"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14"
  },
  "packageManager": "pnpm@11.5.3"
}
